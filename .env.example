# --- Listener publik (dipakai project pemutar / APK) ---
HOST=127.0.0.1
PORT=8787
# Origin yang ditampilkan di dashboard untuk tautan salin/unduh. Di VPS: https://tv.domain-anda.id
PUBLIC_ORIGIN=

# --- Panel admin (dashboard + mutasi). Biarkan loopback; akses lewat SSH tunnel atau HTTPS. ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788
# Layani panel admin di PORT publik (default true) supaya bisa dibuka lewat web/LAN.
# Semua aksi tetap butuh ADMIN_TOKEN. Set false bila panel hanya boleh ada di ADMIN_PORT.
# Di VPS: wajib di balik HTTPS (reverse proxy), jangan biarkan HTTP polos ke internet.
ADMIN_WEB_PANEL=true

# --- Autentikasi ---
# Token admin untuk dashboard dan endpoint mutasi (minimal 24 karakter).
ADMIN_TOKEN=CHANGE_ME_USE_AT_LEAST_24_CHARACTERS
# Opsional: bila diisi, endpoint baca wajib token. Pisahkan dengan koma untuk rotasi.
# Diterima lewat header Authorization: Bearer <token>, atau ?token= pada playlist.
READ_TOKENS=
# Percobaan token salah per IP per menit sebelum 429.
AUTH_FAIL_LIMIT=20
# Permintaan per IP per menit pada listener publik (0 = nonaktif).
RATE_LIMIT=300

# --- Sinkronisasi ---
REFRESH_SECONDS=900
VERIFICATION_SECONDS=1800
REUSE_SECONDS=300
UPSTREAM_TIMEOUT_SECONDS=20
# Hanya periksa stream dari channel terpilih (hemat egress ke pihak ketiga).
PROBE_SELECTED_ONLY=true
UPSTREAM_URL=https://dopaminetv.mikrofast.my.id/api/v1/channels
UPSTREAM_SECRET="CHANGE_ME"
DEVICE_ID=CHANGE_ME
CACHE_FILE=data/snapshot.json
# Port tambahan yang diizinkan untuk URL siaran (selain 80/443 dan port >= 1024).
ALLOWED_PORTS=
